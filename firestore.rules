rules_version = '2';

// OdyoBOT Firestore güvenlik kuralları.
// Bu dosyanın içeriği Firebase konsolunda Firestore Database > Kurallar (Rules) sekmesine yapıştırılır ve "Yayınla" denir.
//
// - Herkes paylaşımları (duyurular: etkinlik, iş ilanı, haber) ve fotoğraflarını (gorseller), ders notları (notlar), cihaz açıklamaları (cihazlar), metin düzenlemeleri (icerik) ve tema ayarını (ayar) okuyabilir.
// - Yalnızca admin hesabı (aşağıdaki UID) yazabilir, değiştirebilir, silebilir.
// - Burada adı geçmeyen her şey kapalıdır. Vaka geçmişi zaten Firebase'e hiç gönderilmez.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "gkXwWVHUirZTWZd7gYwRUqXUCUv2";
    }

    function shortString(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // Tarih alanı: yoksa ya da boşsa geçerli, varsa YYYY-AA-GG.
    function dateField(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].matches('^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    // Ana sayfa paylaşımları. tur: etkinlik (sempozyum/kongre), ilan (iş ilanı), haber (kısa gelişme).
    // Haberde başlık yok, metin zorunlu (en çok 280). Etkinlik ve ilanda başlık zorunlu, açıklama en çok 1000.
    // Eski kayıtlarda tur "haber" + metin yok = sempozyum duyurusu; uygulama bunları okurken etkinlik sayar.
    // Fotoğraf ayrı belgede (gorseller/{gorselId}); burada yalnızca kimliği durur.
    match /duyurular/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['tur', 'baslik', 'kurum', 'tarih', 'baslangic', 'bitis',
             'yer', 'metin', 'link', 'gorselId', 'olusturma', 'guncelleme'])
        && request.resource.data.tur in ['etkinlik', 'ilan', 'haber']
        && request.resource.data.olusturma is number
        && shortString('baslik', 140)
        && shortString('kurum', 120)
        && shortString('yer', 120)
        && shortString('link', 300)
        && shortString('gorselId', 40)
        && dateField('tarih')
        && dateField('baslangic')
        && dateField('bitis')
        && (!('link' in request.resource.data) || request.resource.data.link.matches('^$|^https://[^ ]+$'))
        && (
          (request.resource.data.tur == 'haber'
            && request.resource.data.metin is string
            && request.resource.data.metin.size() > 0
            && request.resource.data.metin.size() <= 280)
          ||
          (request.resource.data.tur != 'haber'
            && request.resource.data.baslik is string
            && request.resource.data.baslik.size() > 0
            && shortString('metin', 1000))
        );
    }

    // Paylaşım fotoğrafları: uygulamada küçültülmüş JPEG, metin olarak (data URL).
    // Firebase Storage ücretsiz planda kapalı olduğu için fotoğraflar burada duruyor.
    match /gorseller/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['veri', 'olusturma'])
        && request.resource.data.olusturma is number
        && request.resource.data.veri is string
        && request.resource.data.veri.size() < 900000
        && request.resource.data.veri.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
    }

    match /notlar/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.baslik is string
        && request.resource.data.baslik.size() > 0
        && shortString('baslik', 100)
        && request.resource.data.maddeler is list
        && request.resource.data.maddeler.size() <= 40;
    }

    // Terimler sözlüğü: Türkçe karşılık (zorunlu), İngilizce terim, kısaltma, açıklama (kartın arka yüzü).
    match /sozluk/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['tr', 'en', 'kisaltma', 'aciklama', 'olusturma', 'guncelleme'])
        && request.resource.data.tr is string
        && request.resource.data.tr.size() > 0
        && shortString('tr', 100)
        && shortString('en', 120)
        && shortString('kisaltma', 30)
        && shortString('aciklama', 1000);
    }

    // Cihaz açıklamaları: belge adı cihazın kimliği (ör. "bte"), içinde madde listesi.
    match /cihazlar/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.maddeler is list
        && request.resource.data.maddeler.size() > 0
        && request.resource.data.maddeler.size() <= 20;
    }

    // Yöneticinin uygulamadaki metinlerde yaptığı değişiklikler (şemalar, notlar, cihaz adları, sayfa yazıları).
    // Belge adı içeriğin anahtarı (ör. "yolak.soc"), içinde yalnızca değiştirilen alanlar.
    match /icerik/{id} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.alanlar is map
        && request.resource.data.alanlar.size() <= 20;
    }

    match /ayar/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Topluluk (forum), 4. adım, 2026-11-21 ----
    // Herkes okur. Yazmak için giriş yapmış ve e-postası doğrulanmış üye; üyelik anahtarı (ayar/uyelik.kayitAcik) açık olmalı
    // (yönetici her zaman). Yazar yalnızca kendi adına yazar ve yalnızca kendi yazısını düzenler. Fotoğraf yok.
    function dogrulanmis() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function uyelikAcik() {
      return get(/databases/$(database)/documents/ayar/uyelik).data.kayitAcik == true;
    }
    function meslekGecerli(field) {
      return request.resource.data[field] in ['', 'ogrenci', 'odyolog', 'diger'];
    }
    match /forum/{id} {
      allow read: if true;
      allow create: if dogrulanmis() && (uyelikAcik() || isAdmin())
        && request.resource.data.keys().hasOnly(['kategori', 'baslik', 'metin', 'yazarId', 'yazarAd', 'yazarMeslek',
             'olusturma', 'guncelleme', 'cevapSayisi', 'sonCevap', 'gizli'])
        && request.resource.data.yazarId == request.auth.uid
        && request.resource.data.gizli == false
        && request.resource.data.cevapSayisi == 0
        && request.resource.data.kategori is string && request.resource.data.kategori.size() <= 30
        && request.resource.data.baslik is string && request.resource.data.baslik.size() >= 3 && request.resource.data.baslik.size() <= 120
        && request.resource.data.metin is string && request.resource.data.metin.size() >= 1 && request.resource.data.metin.size() <= 3000
        && request.resource.data.yazarAd is string && request.resource.data.yazarAd.size() <= 40
        && meslekGecerli('yazarMeslek')
        && request.resource.data.olusturma is number;
      allow update: if (
          // yazar: içeriği düzenler
          request.auth != null && resource.data.yazarId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kategori', 'baslik', 'metin', 'guncelleme'])
          && request.resource.data.baslik is string && request.resource.data.baslik.size() >= 3 && request.resource.data.baslik.size() <= 120
          && request.resource.data.metin is string && request.resource.data.metin.size() >= 1 && request.resource.data.metin.size() <= 3000
          && request.resource.data.kategori is string && request.resource.data.kategori.size() <= 30
        ) || (
          // cevap eklenince/silinince sayaç yalnızca bir artar ya da azalır
          dogrulanmis()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cevapSayisi', 'sonCevap'])
          && (request.resource.data.cevapSayisi == resource.data.cevapSayisi + 1 || request.resource.data.cevapSayisi == resource.data.cevapSayisi - 1)
        ) || (
          isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gizli', 'cevapSayisi', 'sonCevap'])
        );
      allow delete: if isAdmin() || (request.auth != null && resource.data.yazarId == request.auth.uid);

      match /cevaplar/{cid} {
        allow read: if true;
        allow create: if dogrulanmis() && (uyelikAcik() || isAdmin())
          && request.resource.data.keys().hasOnly(['metin', 'yazarId', 'yazarAd', 'yazarMeslek', 'olusturma', 'guncelleme', 'gizli'])
          && request.resource.data.yazarId == request.auth.uid
          && request.resource.data.gizli == false
          && request.resource.data.metin is string && request.resource.data.metin.size() >= 1 && request.resource.data.metin.size() <= 2000
          && request.resource.data.yazarAd is string && request.resource.data.yazarAd.size() <= 40
          && meslekGecerli('yazarMeslek')
          && request.resource.data.olusturma is number;
        allow update: if (
            request.auth != null && resource.data.yazarId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metin', 'guncelleme'])
            && request.resource.data.metin is string && request.resource.data.metin.size() >= 1 && request.resource.data.metin.size() <= 2000
          ) || (
            isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gizli'])
          );
        // cevabın yazarı, gönderinin sahibi ya da yönetici siler
        allow delete: if isAdmin()
          || (request.auth != null && resource.data.yazarId == request.auth.uid)
          || (request.auth != null && get(/databases/$(database)/documents/forum/$(id)).data.yazarId == request.auth.uid);
      }
    }
    // Şikâyetler: doğrulanmış üye oluşturur; yalnızca yönetici okur ve kapatır (siler).
    match /sikayetler/{sid} {
      allow read, delete: if isAdmin();
      allow create: if dogrulanmis()
        && request.resource.data.keys().hasOnly(['hedef', 'neden', 'sikayetEden', 'olusturma'])
        && request.resource.data.sikayetEden == request.auth.uid
        && request.resource.data.hedef is string && request.resource.data.hedef.size() <= 200
        && request.resource.data.neden is string && request.resource.data.neden.size() <= 300
        && request.resource.data.olusturma is number;
    }

    // Üye hesapları (4. adım, 2026-11-21). Belge adı üyenin kimliği (uid).
    // Her üye YALNIZCA kendi belgesini okur, yazar, siler; başka hiç kimse (yönetici dahil) okuyamaz.
    // Alanlar: ad (görünen ad ≤40), meslek, favoriler (not anahtarları ≤200), sozluk (terim → öğrenme durumu ≤2000),
    // olusturma, guncelleme. E-posta burada tutulmaz (yalnızca Firebase Authentication'da). Vaka kayıtları hiç gönderilmez.
    match /uyeler/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ad', 'meslek', 'favoriler', 'sozluk', 'engelli', 'olusturma', 'guncelleme'])
        && shortString('ad', 40)
        && (!('meslek' in request.resource.data) || request.resource.data.meslek in ['', 'ogrenci', 'odyolog', 'diger'])
        && (!('favoriler' in request.resource.data) || (request.resource.data.favoriler is list && request.resource.data.favoriler.size() <= 200))
        && (!('sozluk' in request.resource.data) || (request.resource.data.sozluk is map && request.resource.data.sozluk.size() <= 2000))
        && (!('engelli' in request.resource.data) || (request.resource.data.engelli is map && request.resource.data.engelli.size() <= 200))
        && (!('olusturma' in request.resource.data) || request.resource.data.olusturma is number)
        && (!('guncelleme' in request.resource.data) || request.resource.data.guncelleme is number);
    }
  }
}
